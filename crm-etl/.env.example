# CRM ETL System Environment Variables
# Copy this file to .env and configure your values

# AI API Keys (Optional - for enhanced AI features)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Optional - defaults to SQLite)
DATABASE_URL=sqlite:///crm_etl.db
# For PostgreSQL: postgresql://user:password@localhost:5432/crm_etl
# For MySQL: mysql://user:password@localhost:3306/crm_etl

# Application Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security Settings
SECRET_KEY=your_secret_key_here_change_in_production

# External API Configuration (Optional)
# Configure if you need to integrate with external services
EXTERNAL_API_KEY=your_external_api_key
EXTERNAL_API_URL=https://api.example.com

# Cloud Storage (Optional)
# GCS_BUCKET_NAME=your-gcs-bucket-name
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_BUCKET_NAME=your-s3-bucket-name

# Monitoring and Alerting (Optional)
ENABLE_MONITORING=true
ALERT_EMAIL=admin@yourcompany.com

# Performance Settings
MAX_WORKERS=4
CHUNK_SIZE=10000
MEMORY_LIMIT=2048

# CRM Branding
COMPANY_NAME=CRM ETL
COMPANY_CONTACT=tech@crm.com.br