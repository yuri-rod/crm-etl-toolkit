# Example environment configuration for Supabase & Firebase pipelines
# Copy this file to .env and provide your actual credentials.
# Do not commit .env to version control.

SUPABASE_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your_project_id
SUPABASE_PASSWORD=your_secure_password_here

FIREBASE_CREDS_PATH=firebase-service-account.json
